@model GlowCare_AspNetCore_MVC.Models.Product
@{
    ViewData["Title"] = "Thêm Sản Phẩm Mới (Admin)";
    var categories = ViewBag.Categories as List<GlowCare_AspNetCore_MVC.Models.Category> ?? new();
    var brands = ViewBag.Brands as List<GlowCare_AspNetCore_MVC.Models.Brand> ?? new();
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <div>
                    <h2 class="font-serif fw-bold mb-1"><i class="bi bi-plus-circle-fill text-danger me-2"></i>Thêm Sản Phẩm Dược Mỹ Phẩm Mới</h2>
                    <p class="text-muted small mb-0">Nhập đầy đủ thông tin để sản phẩm xuất hiện trên trang bán hàng</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> Quay Lại Danh Sách
                </a>
            </div>

            <div class="card border-0 shadow rounded-4 p-4 bg-white">
                <form asp-action="CreateProduct" method="post">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger small py-2 mb-3">
                            @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                        </div>
                    }

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="ProductId" class="form-label small fw-bold">Mã Sản Phẩm (ID) *</label>
                            <input asp-for="ProductId" class="form-control" placeholder="vd: serum-b5-laroche" required />
                            <small class="text-muted" style="font-size: 0.72rem;">Mã duy nhất, viết liền không dấu</small>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="ProductName" class="form-label small fw-bold">Tên Sản Phẩm *</label>
                            <input asp-for="ProductName" class="form-control" placeholder="vd: Tinh Chất Phục Hồi Da La Roche-Posay Hyalu B5 Serum" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label small fw-bold">Thuộc Menu / Danh Mục *</label>
                            <select asp-for="CategoryId" class="form-select" required>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.CategoryId">@cat.CategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BrandId" class="form-label small fw-bold">Thương Hiệu *</label>
                            <select asp-for="BrandId" class="form-select" required>
                                @foreach (var brand in brands)
                                {
                                    <option value="@brand.BrandId">@brand.BrandName (@brand.Country)</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Price" class="form-label small fw-bold">Giá Bán Khuyến Mãi (VNĐ) *</label>
                            <input asp-for="Price" type="number" class="form-control" placeholder="385000" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="OriginalPrice" class="form-label small fw-bold">Giá Niêm Yết Gốc (VNĐ) *</label>
                            <input asp-for="OriginalPrice" type="number" class="form-control" placeholder="460000" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DiscountPercent" class="form-label small fw-bold">% Giảm Giá</label>
                            <input asp-for="DiscountPercent" type="number" class="form-control" placeholder="16" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="StockCount" class="form-label small fw-bold">Số Lượng Tồn Kho Ban Đầu *</label>
                            <input asp-for="StockCount" type="number" class="form-control" placeholder="50" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Volume" class="form-label small fw-bold">Dung Tích</label>
                            <input asp-for="Volume" class="form-control" placeholder="30ml, 50ml, 200ml..." />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="RoutineType" class="form-label small fw-bold">Thời Điểm Dùng</label>
                            <select asp-for="RoutineType" class="form-select">
                                <option value="Both">Cả Sáng & Tối (Both)</option>
                                <option value="AM">Chỉ Dùng Ban Sáng (AM)</option>
                                <option value="PM">Chỉ Dùng Ban Đêm (PM)</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ImageUrl" class="form-label small fw-bold">Đường Dẫn Hình Ảnh (URL) *</label>
                        <input asp-for="ImageUrl" class="form-control" placeholder="https://images.unsplash.com/photo-..." required />
                        <small class="text-muted" style="font-size: 0.72rem;">Dán link ảnh Unsplash hoặc ảnh CDN trực tiếp</small>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="SkinTypes" class="form-label small fw-bold">Loại Da Phù Hợp</label>
                            <input asp-for="SkinTypes" class="form-control" placeholder="Da dầu, Da mụn, Da nhạy cảm" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="KeyIngredients" class="form-label small fw-bold">Hoạt Chất Nổi Bật</label>
                            <input asp-for="KeyIngredients" class="form-control" placeholder="Niacinamide, BHA, Hyaluronic Acid" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ShortDesc" class="form-label small fw-bold">Mô Tả Ngắn</label>
                        <textarea asp-for="ShortDesc" class="form-control" rows="2" placeholder="Công dụng nổi bật tóm tắt hiển thị trên thẻ sản phẩm..."></textarea>
                    </div>

                    <div class="mb-4">
                        <label asp-for="FullDesc" class="form-label small fw-bold">Mô Tả Chi Tiết & Hướng Dẫn Sử Dụng</label>
                        <textarea asp-for="FullDesc" class="form-control" rows="4" placeholder="Thành phần đầy đủ, cơ chế tác động và cách bôi lên da..."></textarea>
                    </div>

                    <div class="d-flex gap-3 mb-4 p-3 bg-light rounded-3">
                        <div class="form-check">
                            <input asp-for="IsFeatured" class="form-check-input" type="checkbox" id="chkFeatured" />
                            <label class="form-check-label small fw-semibold" for="chkFeatured">Sản phẩm Nổi Bật (Trang chủ)</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="IsBestSeller" class="form-check-input" type="checkbox" id="chkBest" />
                            <label class="form-check-label small fw-semibold" for="chkBest">Bán Chạy Nhất</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="IsNew" class="form-check-input" type="checkbox" id="chkNew" />
                            <label class="form-check-label small fw-semibold" for="chkNew">Hàng Mới Về</label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy Bỏ</a>
                        <button type="submit" class="btn btn-rose px-5 py-2.5 fw-bold shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Lưu & Xuất Bản Sản Phẩm
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
