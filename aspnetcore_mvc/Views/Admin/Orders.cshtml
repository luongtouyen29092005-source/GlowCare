@model IEnumerable<GlowCare_AspNetCore_MVC.Models.Order>
@{
    ViewData["Title"] = "Quản Lý Đơn Hàng (Sales / Admin)";
}

<div class="container py-5">
    <!-- Admin Navigation Tabs -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="font-serif fw-bold mb-1"><i class="bi bi-clipboard-check text-success me-2"></i>Quản Lý & Duyệt Đơn Hàng</h2>
            <p class="text-muted small mb-0">Cập nhật tiến độ xử lý và giao hàng cho khách</p>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            @if (User.IsInRole("SUPER_ADMIN") || User.IsInRole("WAREHOUSE_STAFF"))
            {
                <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-primary btn-sm px-3 rounded-pill">
                    <i class="bi bi-boxes me-1"></i> Quản Lý Tồn Kho
                </a>
            }
            <a asp-controller="Admin" asp-action="Orders" class="btn btn-success btn-sm px-3 rounded-pill">
                <i class="bi bi-receipt me-1"></i> Quản Lý Đơn Hàng
            </a>
            @if (User.IsInRole("SUPER_ADMIN"))
            {
                <a asp-controller="Admin" asp-action="Categories" class="btn btn-outline-danger btn-sm px-3 rounded-pill">
                    <i class="bi bi-menu-button-wide me-1"></i> Quản Lý Menu
                </a>
                <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-warning text-dark btn-sm px-3 rounded-pill">
                    <i class="bi bi-people-fill me-1"></i> Phân Quyền Nhân Viên
                </a>
                <a asp-controller="Admin" asp-action="SiteSettings" class="btn btn-outline-danger btn-sm px-3 rounded-pill">
                    <i class="bi bi-palette-fill me-1"></i> Cấu Hình Giao Diện
                </a>
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã Đơn</th>
                        <th>Khách Hàng</th>
                        <th>Ngày Đặt</th>
                        <th>Tổng Tiền</th>
                        <th>Thanh Toán</th>
                        <th>Trạng Thái Đơn</th>
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td><span class="badge bg-dark">@order.OrderId</span></td>
                            <td>
                                <div class="fw-semibold">@order.Customer?.FullName</div>
                                <small class="text-muted">@order.Customer?.Phone • @order.ShippingProvince</small>
                            </td>
                            <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-bold text-danger">@order.TotalAmount.ToString("N0") ₫</td>
                            <td>
                                <span class="badge @(order.PaymentStatus == "Đã thanh toán" ? "bg-success" : "bg-warning text-dark")">
                                    @order.PaymentStatus
                                </span>
                            </td>
                            <td>
                                <span class="badge @(order.OrderStatus == "Đã hoàn thành" ? "bg-success" : "bg-primary")">
                                    @order.OrderStatus
                                </span>
                            </td>
                            <td>
                                <form asp-controller="Admin" asp-action="UpdateOrderStatus" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="orderId" value="@order.OrderId" />
                                    <select name="status" class="form-select form-select-sm" style="width: 140px;">
                                        <option value="Chờ xác nhận" selected="@(order.OrderStatus == "Chờ xác nhận")">Chờ xác nhận</option>
                                        <option value="Đang đóng gói" selected="@(order.OrderStatus == "Đang đóng gói")">Đang đóng gói</option>
                                        <option value="Đang giao hàng" selected="@(order.OrderStatus == "Đang giao hàng")">Đang giao hàng</option>
                                        <option value="Đã hoàn thành" selected="@(order.OrderStatus == "Đã hoàn thành")">Đã hoàn thành</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-dark">Cập nhật</button>
                                    <a asp-controller="Cart" asp-action="Invoice" asp-route-id="@order.OrderId" target="_blank" class="btn btn-sm btn-outline-danger" title="Xem & In Hóa Đơn">
                                        <i class="bi bi-printer"></i> Hóa đơn
                                    </a>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
