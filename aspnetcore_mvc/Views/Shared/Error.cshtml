@model GlowCare_AspNetCore_MVC.Models.ErrorViewModel
@{
    ViewData["Title"] = "Lỗi xử lý yêu cầu";
}

<div class="container py-5 text-center">
    <div class="card shadow-sm border-0 p-5 mx-auto" style="max-width: 600px; border-radius: 16px;">
        <div class="mb-3">
            <i class="bi bi-exclamation-triangle text-danger" style="font-size: 3.5rem;"></i>
        </div>
        <h3 class="fw-bold text-danger mb-2">Đã xảy ra sự cố xử lý yêu cầu</h3>
        <p class="text-muted mb-4">Hệ thống ghi nhận sự cố tạm thời. Vui lòng thử tải lại trang hoặc quay về trang chủ.</p>
        
        @if (Model != null && Model.ShowRequestId)
        {
            <div class="alert alert-light border small text-muted text-break mb-4">
                <strong>Mã truy vết (Request ID):</strong> <code>@Model.RequestId</code>
            </div>
        }

        <div class="d-flex justify-content-center gap-2">
            <a href="/" class="btn btn-rose px-4 py-2">
                <i class="bi bi-house-door me-1"></i> Về Trang Chủ
            </a>
            <a href="javascript:location.reload()" class="btn btn-outline-secondary px-4 py-2">
                <i class="bi bi-arrow-clockwise me-1"></i> Tải lại trang
            </a>
        </div>
    </div>
</div>
