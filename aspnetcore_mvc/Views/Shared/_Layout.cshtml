@inject GlowCare_AspNetCore_MVC.Data.ApplicationDbContext _layoutDbContext
@{
    var siteSetting = _layoutDbContext.SiteSettings.FirstOrDefault() ?? new GlowCare_AspNetCore_MVC.Models.SiteSetting();
    var primaryColor = string.IsNullOrEmpty(siteSetting.PrimaryColor) ? "#be123c" : siteSetting.PrimaryColor;
    var accentColor = string.IsNullOrEmpty(siteSetting.AccentColor) ? "#f43f5e" : siteSetting.AccentColor;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @siteSetting.SiteName (ASP.NET Core MVC)</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --primary-rose: @primaryColor;
            --gc-primary: @primaryColor;
            --gc-accent: @accentColor;
            --rose-bg: #fff1f2;
        }
        body {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            background-color: #fafaf9;
            color: #1c1917;
        }
        .navbar-brand-custom {
            font-family: serif;
            font-weight: 700;
            font-size: 1.5rem;
            color: var(--gc-primary) !important;
        }
        .badge-rose {
            background-color: var(--gc-accent);
            color: white;
        }
        .btn-rose {
            background-color: var(--gc-primary) !important;
            border-color: var(--gc-primary) !important;
            color: white !important;
            border-radius: 9999px;
            font-weight: 600;
        }
        .btn-rose:hover {
            filter: brightness(0.9);
            color: white !important;
        }
        .text-rose {
            color: var(--gc-primary) !important;
        }
        .card-product {
            border: 1px solid #e7e5e4;
            border-radius: 1rem;
            transition: transform 0.2s, box-shadow 0.2s;
            overflow: hidden;
            background: white;
        }
        .card-product:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Top Announcement Bar (Tùy biến động từ Admin) -->
    <div class="text-white py-1 px-3 text-center text-small small" style="background: linear-gradient(90deg, #1c1917, var(--gc-primary), #1c1917);">
        <span class="badge bg-light text-dark rounded-pill me-2">Thông báo</span>
        <span>@siteSetting.AnnouncementText</span>
        <span class="ms-3 d-none d-md-inline">• Hotline: <b>@siteSetting.Hotline</b></span>
    </div>

    <!-- Main Navigation -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top py-3">
        <div class="container">
            <a class="navbar-brand navbar-brand-custom d-flex items-center gap-2" asp-controller="Home" asp-action="Index">
                <i class="bi bi-droplet-half" style="color: var(--gc-primary);"></i> @siteSetting.LogoText
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMain">
                <!-- Search bar -->
                <form class="d-flex mx-auto my-2 my-lg-0 w-50" asp-controller="Products" asp-action="Index" method="get">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input class="form-control bg-light border-start-0" type="search" name="search" placeholder="Tìm kiếm serum, sữa rửa mặt, BHA..." value="@ViewBag.SearchQuery">
                    </div>
                </form>

                <!-- Right Nav Actions -->
                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    <!-- Dynamic Database Menu Dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle fw-semibold text-dark" href="#" id="menuCategories" data-bs-toggle="dropdown">
                            <i class="bi bi-grid-fill text-danger me-1"></i> Menu Sản Phẩm
                        </a>
                        <ul class="dropdown-menu shadow border-0 rounded-3" style="min-width: 220px;">
                            <li>
                                <a class="dropdown-item py-2 fw-semibold" asp-controller="Products" asp-action="Index">
                                    <i class="bi bi-collection me-2 text-danger"></i> Tất Cả Sản Phẩm
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            @{
                                var navCategories = _layoutDbContext.Categories.OrderBy(c => c.CategoryId).ToList();
                                foreach (var cat in navCategories)
                                {
                                    <li>
                                        <a class="dropdown-item py-1.5" asp-controller="Products" asp-action="Index" asp-route-category="@cat.CategoryName">
                                            <i class="bi bi-chevron-right text-muted small me-2" style="font-size: 0.7rem;"></i> @cat.CategoryName
                                        </a>
                                    </li>
                                }
                            }
                            @if (User.IsInRole("SUPER_ADMIN"))
                            {
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <a class="dropdown-item py-1.5 text-danger fw-bold" asp-controller="Admin" asp-action="Categories">
                                        <i class="bi bi-gear-fill me-1"></i> Quản Lý & Sửa Menu
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link fw-semibold text-danger" asp-controller="Home" asp-action="SkinQuiz">
                            <i class="bi bi-stars"></i> Chẩn Đoán Da
                        </a>
                    </li>
                    @{
                        var sessionUser = Context.Session.GetString("UserName");
                        var isAuth = (User.Identity?.IsAuthenticated == true) || !string.IsNullOrEmpty(sessionUser);
                        var uName = User.Identity?.Name ?? sessionUser ?? "";
                        var fName = User.FindFirst("FullName")?.Value ?? Context.Session.GetString("FullName") ?? uName;
                        var uRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? Context.Session.GetString("UserRole") ?? "CUSTOMER";
                        var uRoleName = User.FindFirst("RoleName")?.Value ?? Context.Session.GetString("UserRoleName") ?? (uRole == "SUPER_ADMIN" ? "Quản trị viên Cấp cao" : (uRole == "WAREHOUSE_STAFF" ? "Thủ kho" : (uRole == "SALES_STAFF" ? "Nhân viên Bán hàng" : "Khách hàng Thân thiết")));
                        
                        // Đếm số lượng sản phẩm trong Giỏ hàng từ Session
                        var cartSessionJson = Context.Session.GetString("GlowCare_Cart_Items");
                        var cartBadgeCount = 0;
                        if (!string.IsNullOrEmpty(cartSessionJson))
                        {
                            try {
                                var cartList = System.Text.Json.JsonSerializer.Deserialize<List<GlowCare_AspNetCore_MVC.Models.CartItem>>(cartSessionJson);
                                cartBadgeCount = cartList?.Sum(c => c.Quantity) ?? 0;
                            } catch {}
                        }
                    }

                    <li class="nav-item">
                        <a class="btn btn-outline-dark rounded-pill px-3 position-relative" asp-controller="Cart" asp-action="Index">
                            <i class="bi bi-bag"></i> Giỏ Hàng
                            @if (cartBadgeCount > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger shadow-xs">
                                    @cartBadgeCount
                                </span>
                            }
                        </a>
                    </li>

                    <!-- RBAC User Menu (Chuẩn Web Thương Mại Điện Tử) -->
                    @if (isAuth)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 py-1 px-3 border rounded-pill bg-light shadow-xs" href="#" id="userMenu" data-bs-toggle="dropdown">
                                <span class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center fw-bold shadow-xs" style="width: 30px; height: 30px; font-size: 0.8rem;">
                                    @(fName?.Length > 0 ? fName.Substring(0, 1).ToUpper() : "U")
                                </span>
                                <div class="text-start me-1">
                                    <div class="small fw-bold lh-1 text-truncate text-dark" style="max-width: 130px;">@fName</div>
                                    <span class="badge @(uRole == "SUPER_ADMIN" ? "bg-warning text-dark" : uRole == "WAREHOUSE_STAFF" ? "bg-primary" : uRole == "SALES_STAFF" ? "bg-success" : "bg-danger") px-1 py-0 mt-0.5" style="font-size: 0.65rem;">
                                        @uRoleName
                                    </span>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3" style="min-width: 260px;">
                                <li class="px-3 py-2 border-bottom bg-light rounded-top">
                                    <div class="small text-muted">Đang đăng nhập với:</div>
                                    <div class="fw-bold text-dark">@fName <small class="text-muted fw-normal">(@uName)</small></div>
                                    <span class="badge @(uRole == "SUPER_ADMIN" ? "bg-warning text-dark" : uRole == "WAREHOUSE_STAFF" ? "bg-primary" : uRole == "SALES_STAFF" ? "bg-success" : "bg-danger") mt-1">
                                        @uRoleName
                                    </span>
                                </li>

                                <!-- Menu dành riêng cho Khách hàng -->
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Account" asp-action="Orders">
                                        <i class="bi bi-box2-heart text-danger me-2"></i> Đơn hàng của tôi
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person-gear text-secondary me-2"></i> Thông tin tài khoản
                                    </a>
                                </li>

                                <!-- Menu dành riêng cho Quản trị viên (Super Admin) - Toàn quyền -->
                                @if (uRole == "SUPER_ADMIN")
                                {
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li class="dropdown-header text-uppercase small fw-bold text-warning">Khu vực Toàn Quyền Admin</li>
                                    <li>
                                        <a class="dropdown-item py-1.5 fw-semibold text-danger" asp-controller="Admin" asp-action="SiteSettings">
                                            <i class="bi bi-palette-fill text-danger me-2"></i> Cấu Hình Banner & Màu Sắc
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-1.5 fw-semibold text-warning" asp-controller="Admin" asp-action="Users">
                                            <i class="bi bi-people-fill text-warning me-2"></i> Phân Quyền Nhân Viên
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-1.5 fw-semibold" asp-controller="Admin" asp-action="Categories">
                                            <i class="bi bi-menu-button-wide text-primary me-2"></i> Thêm, Sửa, Xóa Menu
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-1.5 fw-semibold" asp-controller="Admin" asp-action="CreateProduct">
                                            <i class="bi bi-plus-circle-fill text-success me-2"></i> Thêm Sản Phẩm Mới
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-1.5" asp-controller="Admin" asp-action="Index">
                                            <i class="bi bi-boxes text-primary me-2"></i> Quản Lý Sản Phẩm & Kho
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-1.5" asp-controller="Admin" asp-action="Orders">
                                            <i class="bi bi-receipt-cutoff text-success me-2"></i> Quản Lý Tất Cả Đơn Hàng
                                        </a>
                                    </li>
                                }

                                <!-- Menu dành riêng cho Thủ kho -->
                                @if (uRole == "WAREHOUSE_STAFF")
                                {
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li class="dropdown-header text-uppercase small fw-bold text-primary">Nghiệp vụ Thủ Kho</li>
                                    <li>
                                        <a class="dropdown-item py-2 fw-semibold text-primary" asp-controller="Admin" asp-action="Index">
                                            <i class="bi bi-box-seam me-2"></i> Quản lý Nhập hàng & Tồn kho
                                        </a>
                                    </li>
                                }

                                <!-- Menu dành riêng cho Nhân viên Bán hàng -->
                                @if (uRole == "SALES_STAFF")
                                {
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li class="dropdown-header text-uppercase small fw-bold text-success">Nghiệp vụ Bán Hàng</li>
                                    <li>
                                        <a class="dropdown-item py-2 fw-semibold text-success" asp-controller="Admin" asp-action="Orders">
                                            <i class="bi bi-clipboard-check me-2"></i> Xử lý & Duyệt Đơn Hàng
                                        </a>
                                    </li>
                                }

                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <a class="dropdown-item py-2 text-danger fw-semibold" asp-controller="Account" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i> Đăng Xuất
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <!-- Chưa đăng nhập: Nút Đăng Nhập & Đăng Ký rõ ràng -->
                        <li class="nav-item">
                            <a class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-person me-1"></i> Đăng Nhập
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-sm btn-rose rounded-pill px-3 shadow-sm" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i> Đăng Ký
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- ========================================================================= -->
    <!-- THANH MENU ĐIỀU HƯỚNG DANH MỤC TOÀN TRANG (HORIZONTAL CATEGORY MENU BAR) -->
    <!-- ========================================================================= -->
    <div class="bg-white border-bottom shadow-xs py-2">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <nav class="d-flex align-items-center gap-1 flex-wrap overflow-x-auto text-nowrap py-1">
                    <a class="btn btn-sm btn-light rounded-pill px-3 py-1.5 fw-bold text-dark border-0 me-1" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door-fill text-danger me-1"></i> Trang Chủ
                    </a>
                    <a class="btn btn-sm btn-light rounded-pill px-3 py-1.5 fw-semibold text-dark border-0 me-1" asp-controller="Products" asp-action="Index">
                        <i class="bi bi-grid-3x3-gap-fill text-muted me-1"></i> Tất Cả Sản Phẩm
                    </a>
                    @{
                        var navCategoryList = _layoutDbContext.Categories.OrderBy(c => c.CategoryId).ToList();
                        foreach (var cat in navCategoryList)
                        {
                            <a class="btn btn-sm btn-light rounded-pill px-3 py-1.5 text-secondary fw-semibold border-0 me-1" asp-controller="Products" asp-action="Index" asp-route-category="@cat.CategoryName">
                                @cat.CategoryName
                            </a>
                        }
                    }
                    <a class="btn btn-sm rounded-pill px-3 py-1.5 fw-bold text-danger border-0" style="background-color: #fff1f2;" asp-controller="Home" asp-action="SkinQuiz">
                        <i class="bi bi-stars me-1"></i> Chẩn Đoán Da
                    </a>
                </nav>

                @if (User.IsInRole("SUPER_ADMIN"))
                {
                    <div class="d-flex align-items-center gap-1 ms-auto">
                        <a asp-controller="Admin" asp-action="Categories" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 fw-bold shadow-xs" title="Thêm, sửa, xóa các mục trên thanh Menu này">
                            <i class="bi bi-pencil-square me-1"></i> Quản Lý & Sửa Menu
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Alerts Notification -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show container mt-3 mb-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show container mt-3 mb-0 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Main Body Container -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer (Thông tin thương hiệu động) -->
    <footer class="bg-dark text-white-50 py-5 mt-auto border-top border-secondary">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="text-white font-serif">@siteSetting.SiteName</h5>
                    <p class="small text-muted mb-2">@siteSetting.Tagline</p>
                    <p class="small text-muted mb-1"><i class="bi bi-geo-alt me-2 text-danger"></i>@siteSetting.Address</p>
                    <p class="small text-muted mb-1"><i class="bi bi-telephone me-2 text-primary"></i>Hotline: @siteSetting.Hotline</p>
                    <p class="small text-muted"><i class="bi bi-envelope me-2 text-warning"></i>Email: @siteSetting.Email</p>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white">Kiến trúc Hệ Thống MVC & RBAC</h6>
                    <ul class="list-unstyled small">
                        <li><b>Model:</b> Entity Framework Core 8 + SQL Server</li>
                        <li><b>View:</b> Razor Views (.cshtml) + Dynamic Theme Customizer</li>
                        <li><b>Controller:</b> Phân quyền RBAC & Quản trị toàn diện</li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white">Cơ sở dữ liệu & Phân quyền</h6>
                    <p class="small mb-1"><i class="bi bi-database me-2"></i>Database: <code>glowcare_skincare_db</code></p>
                    <p class="small"><i class="bi bi-shield-check me-2"></i>Phân quyền: Super Admin / Thủ kho / Sales / Khách hàng</p>
                </div>
            </div>
            <hr class="border-secondary my-4">
            <div class="text-center small">
                © 2026 @siteSetting.SiteName. Hệ thống Dược Mỹ Phẩm ASP.NET Core 8 MVC.
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
