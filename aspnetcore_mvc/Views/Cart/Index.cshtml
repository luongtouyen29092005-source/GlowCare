@model List<GlowCare_AspNetCore_MVC.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ Hàng Của Bạn";
}

<div class="container py-5">
    <h2 class="font-serif fw-bold mb-4"><i class="bi bi-bag-check text-danger"></i> Giỏ Hàng (@Model.Sum(x => x.Quantity) sản phẩm)</h2>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 border p-5">
            <i class="bi bi-cart-x text-muted display-1"></i>
            <h4 class="mt-3">Giỏ hàng của bạn đang trống</h4>
            <p class="text-muted">Hãy chọn các sản phẩm chăm sóc da phù hợp để bắt đầu chu trình dưỡng da.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-rose px-4 py-2 mt-2">
                Khám phá sản phẩm ngay
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Sản Phẩm</th>
                                    <th>Đơn Giá</th>
                                    <th class="text-center">Số Lượng</th>
                                    <th>Thành Tiền</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@item.Product.ImageUrl" alt="@item.Product.ProductName" style="width: 60px; height: 60px; object-fit: cover;" class="rounded-3 border">
                                                <div>
                                                    <h6 class="mb-0 fw-semibold">@item.Product.ProductName</h6>
                                                    <small class="text-muted">Dung tích: @item.Product.Volume</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="fw-semibold">@item.Product.Price.ToString("N0") ₫</td>
                                        <td class="text-center">
                                            <div class="d-inline-flex align-items-center border rounded-pill p-1 bg-white shadow-xs">
                                                <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-inline m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="productId" value="@item.Product.ProductId" />
                                                    <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                                                    <button type="submit" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 26px; height: 26px;">
                                                        <i class="bi bi-dash"></i>
                                                    </button>
                                                </form>
                                                <span class="px-2.5 fw-bold small">@item.Quantity</span>
                                                <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-inline m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="productId" value="@item.Product.ProductId" />
                                                    <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                                                    <button type="submit" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 26px; height: 26px;">
                                                        <i class="bi bi-plus"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                        <td class="fw-bold text-danger">@item.LineTotal.ToString("N0") ₫</td>
                                        <td>
                                            <form asp-controller="Cart" asp-action="RemoveFromCart" method="post">
                                                <input type="hidden" name="productId" value="@item.Product.ProductId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger border-0">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <h5 class="fw-bold mb-3">Tóm Tắt Đơn Hàng</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tạm tính:</span>
                        <span class="fw-semibold">@(((decimal)ViewBag.Subtotal).ToString("N0")) ₫</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Phí vận chuyển:</span>
                        <span class="fw-semibold">@(((decimal)ViewBag.ShippingFee) == 0 ? "Miễn phí" : ((decimal)ViewBag.ShippingFee).ToString("N0") + " ₫")</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-4">
                        <span class="fs-5 fw-bold">Tổng thanh toán:</span>
                        <span class="fs-4 fw-bold text-danger">@(((decimal)ViewBag.Total).ToString("N0")) ₫</span>
                    </div>

                    <a asp-controller="Cart" asp-action="Checkout" class="btn btn-rose w-100 py-3 fw-bold">
                        Tiến Hành Đặt Hàng <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>
