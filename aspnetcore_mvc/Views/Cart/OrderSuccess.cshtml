@model GlowCare_AspNetCore_MVC.Models.Order
@{
    ViewData["Title"] = "Đặt Hàng Thành Công";
}

<div class="container py-5">
    <div class="card border-0 shadow-sm rounded-4 p-5 max-w-lg mx-auto text-center" style="max-width: 650px;">
        <div class="text-success display-3 mb-3">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <h2 class="fw-bold font-serif mb-2">Đặt Hàng Thành Công!</h2>
        <p class="text-muted">Cảm ơn bạn đã lựa chọn sản phẩm chăm sóc da chính hãng tại GlowCare.</p>

        <div class="p-3 bg-light rounded-3 my-3 text-start small">
            <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Mã đơn hàng:</span>
                <span class="fw-bold text-danger">@Model.OrderId</span>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Người nhận:</span>
                <span class="fw-semibold">@Model.Customer?.FullName (@Model.Customer?.Phone)</span>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Địa chỉ nhận:</span>
                <span>@Model.ShippingAddress, @Model.ShippingProvince</span>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Phương thức:</span>
                <span class="badge bg-secondary">@Model.PaymentMethod</span>
            </div>
            <div class="d-flex justify-content-between mt-2 pt-2 border-top">
                <span class="fw-bold">Tổng thanh toán:</span>
                <span class="fw-bold text-danger fs-6">@Model.TotalAmount.ToString("N0") ₫</span>
            </div>
        </div>

        @if (Model.PaymentMethod == "VIETQR")
        {
            <div class="p-3 border border-success-subtle bg-success-subtle rounded-3 my-3 text-center">
                <h6 class="fw-bold text-success mb-2"><i class="bi bi-qr-code-scan me-1"></i> Quét Mã VietQR Chuyển Khoản</h6>
                <img src="https://api.vietqr.io/image/970422-0901234567-compact2.jpg?amount=@((long)Model.TotalAmount)&addInfo=@Model.OrderId"
                     alt="VietQR" class="img-fluid rounded border shadow-xs" style="max-width: 200px;" />
                <p class="small text-muted mt-2 mb-0">Ngân hàng MB Bank • Số TK: 0901234567 • Chủ TK: GLOWCARE</p>
            </div>
        }

        <!-- Hóa Đơn & Hành Động -->
        <div class="d-flex flex-wrap gap-2 justify-content-center mt-4">
            <a asp-controller="Cart" asp-action="Invoice" asp-route-id="@Model.OrderId" target="_blank" class="btn btn-danger rounded-pill px-4 py-2.5 fw-bold shadow-sm">
                <i class="bi bi-printer-fill me-1"></i> Xuất / In Hóa Đơn
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark rounded-pill px-4 py-2.5">
                Về Trang Chủ
            </a>
            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-danger rounded-pill px-4 py-2.5">
                Tiếp Tục Mua Sắm
            </a>
        </div>
    </div>
</div>
