@model GlowCare_AspNetCore_MVC.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card border-0 shadow rounded-4 p-4 bg-white">
                <div class="text-center mb-4">
                    <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center p-3 mb-2" style="width: 56px; height: 56px;">
                        <i class="bi bi-shield-lock-fill fs-3"></i>
                    </div>
                    <h3 class="fw-bold font-serif mb-1">Đăng Nhập</h3>
                    <p class="text-muted small">Đăng nhập tài khoản của bạn để tiếp tục</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger small py-2 mb-3">
                        @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                    </div>
                }

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label small fw-bold">Tên đăng nhập hoặc Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-person text-muted"></i></span>
                            <input asp-for="Username" id="inputUsername" class="form-control" placeholder="Nhập tên đăng nhập hoặc email..." value="admin" required autofocus />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Password" class="form-label small fw-bold mb-0">Mật khẩu</label>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-key text-muted"></i></span>
                            <input asp-for="Password" id="inputPassword" type="password" class="form-control" placeholder="Nhập mật khẩu..." value="123456" required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe" checked />
                        <label class="form-check-label small text-muted" for="rememberMe">
                            Ghi nhớ đăng nhập
                        </label>
                    </div>

                    <button type="submit" class="btn btn-rose w-100 py-2.5 fw-bold mb-3 shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập Ngay
                    </button>

                    <!-- Quick 1-Click Demo Login Options -->
                    <div class="border-top pt-3 mb-3">
                        <div class="text-center small text-muted fw-bold mb-2">⚡ ĐĂNG NHẬP NHANH 1-CHẠM (DEMO):</div>
                        <div class="row g-2">
                            <div class="col-6">
                                <a asp-action="QuickLogin" asp-route-role="SUPER_ADMIN" class="btn btn-sm btn-outline-danger w-100 py-1.5 fw-semibold rounded-3 text-start">
                                    <i class="bi bi-shield-lock text-danger me-1"></i> 👑 Admin
                                </a>
                            </div>
                            <div class="col-6">
                                <a asp-action="QuickLogin" asp-route-role="CUSTOMER" class="btn btn-sm btn-outline-dark w-100 py-1.5 fw-semibold rounded-3 text-start">
                                    <i class="bi bi-person-heart text-danger me-1"></i> 👤 Khách hàng
                                </a>
                            </div>
                            <div class="col-6">
                                <a asp-action="QuickLogin" asp-route-role="WAREHOUSE_STAFF" class="btn btn-sm btn-outline-primary w-100 py-1.5 fw-semibold rounded-3 text-start">
                                    <i class="bi bi-box-seam me-1"></i> 📦 Thủ kho
                                </a>
                            </div>
                            <div class="col-6">
                                <a asp-action="QuickLogin" asp-route-role="SALES_STAFF" class="btn btn-sm btn-outline-success w-100 py-1.5 fw-semibold rounded-3 text-start">
                                    <i class="bi bi-bag-check me-1"></i> 💼 Sales
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="text-center small text-muted">
                        Chưa có tài khoản? 
                        <a asp-action="Register" class="fw-bold text-danger text-decoration-none">Đăng ký ngay</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
