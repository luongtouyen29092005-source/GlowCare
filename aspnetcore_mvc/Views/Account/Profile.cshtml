@model GlowCare_AspNetCore_MVC.Models.ProfileViewModel
@{
    ViewData["Title"] = "Thông Tin Tài Khoản";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow rounded-4 p-4 bg-white">
                <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                    <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center fw-bold fs-4" style="width: 60px; height: 60px;">
                        @(Model.FullName?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                    <div>
                        <h4 class="fw-bold font-serif mb-1">@Model.FullName</h4>
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-muted small">@Model.Email</span>
                            <span class="badge @(Model.Role == "SUPER_ADMIN" ? "bg-warning text-dark" : Model.Role == "WAREHOUSE_STAFF" ? "bg-primary" : Model.Role == "SALES_STAFF" ? "bg-success" : "bg-danger")">
                                @Model.RoleName
                            </span>
                        </div>
                    </div>
                </div>

                <form asp-action="UpdateProfile" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Tên Đăng Nhập (Username)</label>
                        <input type="text" class="form-control bg-light" value="@Model.Username" readonly />
                        <small class="text-muted" style="font-size: 0.75rem;">Tên đăng nhập không thể thay đổi</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Email</label>
                        <input type="email" class="form-control bg-light" value="@Model.Email" readonly />
                        <small class="text-muted" style="font-size: 0.75rem;">Email định danh tài khoản</small>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label small fw-bold">Họ và Tên</label>
                            <input asp-for="FullName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label small fw-bold">Số Điện Thoại</label>
                            <input asp-for="Phone" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label small fw-bold">Địa Chỉ Giao Hàng Mặc Định</label>
                        <input asp-for="Address" class="form-control" placeholder="Số nhà, tên đường, phường/xã..." />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Province" class="form-label small fw-bold">Tỉnh / Thành Phố</label>
                        <input asp-for="Province" class="form-control" placeholder="Hà Nội, TP.HCM..." />
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <button type="submit" class="btn btn-rose px-4 py-2 fw-bold">
                            <i class="bi bi-floppy me-1"></i> Lưu Thay Đổi
                        </button>
                        <a asp-action="Logout" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i> Đăng Xuất
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
