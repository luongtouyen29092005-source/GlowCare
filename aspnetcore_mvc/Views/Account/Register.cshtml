@model GlowCare_AspNetCore_MVC.Models.RegisterViewModel
@{
    ViewData["Title"] = "Đăng Ký Tài Khoản";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow rounded-4 p-4 bg-white">
                <div class="text-center mb-4">
                    <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center p-3 mb-2" style="width: 56px; height: 56px;">
                        <i class="bi bi-person-plus-fill fs-3"></i>
                    </div>
                    <h3 class="fw-bold font-serif mb-1">Tạo Tài Khoản Mới</h3>
                    <p class="text-muted small">Đăng ký thành viên GlowCare Skincare Lab</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger small py-2 mb-3">
                        @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                    </div>
                }

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label small fw-bold">Họ và Tên *</label>
                            <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label small fw-bold">Số Điện Thoại *</label>
                            <input asp-for="Phone" class="form-control" placeholder="0901234567" required />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-bold">Email *</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="nguyenvana@gmail.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label small fw-bold">Tên Đăng Nhập (Username) *</label>
                        <input asp-for="Username" class="form-control" placeholder="nguyenvana (viết liền, không dấu)" required />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label small fw-bold">Mật Khẩu *</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Tối thiểu 6 ký tự" required />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label small fw-bold">Xác Nhận Mật Khẩu *</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu" required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-rose w-100 py-2.5 fw-bold mb-3 shadow-sm">
                        <i class="bi bi-person-check-fill me-1"></i> Đăng Ký Tài Khoản
                    </button>

                    <div class="text-center small text-muted">
                        Đã có tài khoản? 
                        <a asp-action="Login" class="fw-bold text-danger text-decoration-none">Đăng nhập tại đây</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
